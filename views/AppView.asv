        function update( ~ ) 
            %UPDATE Update the view. This method is empty because there are 
            %no public properties of the view. 

        end

    end

    methods ( Access = private ) 

        function onDataChanged(view, ~, ~) 
            disp(view.Model)
        end

    end

end
classdef AppView < Component

    properties ( Access = private )
        HomeTab HomeView
        TabGroup matlab.ui.container.TabGroup
        Listener(:, 1) event.listener {mustBeScalarOrEmpty}
    end

    methods

        function obj = AppView(model, tab_group, namedArgs)

            arguments
                model Model
                tab_group
                namedArgs.?AppView 
            end 

            obj@Component(model) 

            obj.TabGroup = tab_group;

            % Listen for changes to the data. 
            obj.Listener = listener( obj.Model, ... 
                "DataChanged", @obj.onDataChanged );

            % Set any user-specified properties.
            set( obj, namedArgs ) 

            % Refresh the view. 
            onDataChanged( obj ) 

        end 

    end 

    methods ( Access = protected ) 

        function setup(view) 
            % Create HomeTab
            view.TabGroup = uitabgroup();

            view.HomeTab = uitab(view.TabGroup);
            view.HomeTab.Title = 'Home';
            hv = HomeView()


classdef Utility
    methods (Static)
        function output = apply_check(idxs)
            emojis = ["❌", "✅"];
            output = arrayfun(@(n) emojis(n + 1), idxs);
        end

        function output = check_or_none(idxs)
            emojis = ["", "✅"];
            output = arrayfun(@(n) emojis(n + 1), idxs);
        end

        function names = path2name(paths)
            arguments
                paths (:, 1) string
            end
            [~, a, b] = fileparts(paths);
            names = a + b;
        end

        function flat = flatten(arr)
            flat = reshape(arr, [], 1);
        end

        function ui_tree = create_rs_tree(st_table, idx)
            parent_acc = st_table(st_table.id == idx).acronym;

            ui_tree = uitre

            child_subtable = st_table([st_table.parent_structure_id] == idx);
            child_idxs = [child_subtable.id];
            child_keys = [child_subtable.acronym];

            if numel(child_idxs) == 0
                ui_tree = child_idxs;
                return
            end
            recursive_find = @(i) Atlas.child_idxs_from_table(st_table, i);
            others = arrayfun(recursive_find, child_idxs, 'UniformOutput', false);
            idxs = [child_idxs, cell2mat(others)];
        end
    end
end

